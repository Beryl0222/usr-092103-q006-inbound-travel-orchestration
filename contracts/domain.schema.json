{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "入境游服务编排领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "IDENTITY_VERIFIED",
        "SERVICE_AUTHORIZED",
        "RESERVATION_CONFIRMED",
        "COMPENSATION_STARTED",
        "ITINERARY_UPDATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "traveler_session",
        "service_authorization",
        "itinerary_revision",
        "orchestration_step"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
